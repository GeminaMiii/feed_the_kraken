{
  "name": "feed-the-kraken-online",
  "private": true,
  "version": "1.0.0",
  "description": "《险恶疑航》Feed the Kraken 在线多人对战服务",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test -w packages/engine && npm run test -w packages/server",
    "dev:server": "npm run dev -w packages/server",
    "dev:client": "npm run dev -w packages/client",
    "start": "npm run start -w packages/server"
  },
  "engines": {
    "node": ">=20"
  }
}

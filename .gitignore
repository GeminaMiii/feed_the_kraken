# ===== 依赖 =====
node_modules/

# ===== 构建产物 =====
dist/
packages/*/dist/
*.tsbuildinfo

# ===== 运行时数据（含对局存档与会话凭据哈希，严禁上传）=====
/data/
*.db
*.db-wal
*.db-shm

# ===== 密钥与环境变量 =====
.env
.env.*
!.env.example
*.local
deploy/*credentials*
*.pem
*.key

# ===== 大体积第三方二进制（cloudflared 等工具请自行下载）=====
deploy/cloudflared*
cloudflared*


# ===== 日志 =====
logs/
*.log
deploy/tunnel_log.txt
npm-debug.log*

# ===== 编辑器与操作系统 =====
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ===== 测试与覆盖率产物 =====
coverage/

# ===== 临时文件 =====
*.tmp
*.bak

# ===== 本地改动文档（仅本机，不随仓库分发）=====
local_docs/

# ===== 角色卡面原始素材（63MB，含官方俄文 PDF，版权与体积均不宜入仓）=====
docs/characters/

# ===== Agent 计划目录（仅本机）=====
.zcode/
.workbuddy/

# Git Bash 下误建的空文件（>nul 重定向产物）
nul
